      <h1 class="home-title">Pablo Magariños</h1>
      <p class="home-subtitle">Aerospace engineer researching how embodied AI can learn from its environment</p>
    </div>
    <div class="home-hero__portrait">{% picture "src/images/portrait.jpeg", "Portrait of Pablo Magariños", { widths: ["auto"], sizes: "(max-width: 600px) 20rem, 11rem", loading: "eager", fetchpriority: "high" } %}</div>
