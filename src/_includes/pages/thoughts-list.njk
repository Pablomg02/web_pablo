{#- The essay list of /thoughts/ and /es/thoughts/: the essays written in the
   page's language, newest first. The introduction is in each page file. #}
{% set t = i18n[lang] %}
{% set notes = collections.thought | inLanguage(lang) | reverse %}
{% if notes.length %}
  <ul class="essay-list">
    {% for post in notes %}
      <li class="essay-list__item">
        <a href="{{ post.url | relativeUrl(page.url) }}">{{ post.data.title }}</a>
        {% if post.date %}
          <div class="essay-list__meta">
            <time datetime="{{ post.date | dateToFormat }}">{{ post.date | dateToFormat('dd-MM-yyyy') }}</time>
            {% if post.data.updated %}
              <span aria-hidden="true">|</span>
              <span>{{ t.lastEdited }} <time datetime="{{ post.data.updated | dateToFormat }}">{{ post.data.updated | dateToFormat('dd-MM-yyyy') }}</time></span>
            {% endif %}
          </div>
        {% endif %}
        {% if post.data.description %}
          <p class="essay-list__description">{{ post.data.description }}</p>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% else %}
  <p>{{ t.noNotes }}</p>
{% endif %}
