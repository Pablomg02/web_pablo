---js
{
  // The old /notes/<slug>/ addresses only ever held the English essays.
  pagination: {
    data: "collections.thought",
    size: 1,
    alias: "post",
    before: (posts) => posts.filter((post) => post.data.lang === "en"),
  },
  permalink: "/notes/{{ post.fileSlug }}/",
  eleventyExcludeFromCollections: true,
}
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Redirecting&hellip;</title>
<link rel="canonical" href="{{ post.url }}">
<meta name="robots" content="noindex">
<meta http-equiv="refresh" content="0; url={{ post.url }}">
</head>
<body>
<p>This page has moved to <a href="{{ post.url }}">{{ post.url }}</a>.</p>
</body>
</html>
